#!/bin/sh /etc/rc.common
# 邻传（内网文件互传）：独立的 uhttpd 实例 + 内网 STUN 应答器，只监听 LAN 口 IPv4。
# 不改 LuCI 的 uhttpd、不加防火墙规则：LAN 区默认放行入站，WAN 侧照旧拒绝。
START=95
STOP=10
USE_PROCD=1

WWW=/usr/share/lan-transfer/www
STUN=/usr/share/lan-transfer/stun.uc

start_service() {
	local enabled port lan_ip

	config_load lan-transfer
	config_get_bool enabled main enabled 1
	config_get port main port 8080
	[ "$enabled" = 1 ] || return 0
	case "$port" in
		''|*[!0-9]*|80|443) port=8080 ;;
	esac
	[ "$port" -ge 1 ] && [ "$port" -le 65535 ] || port=8080

	. /lib/functions/network.sh
	network_get_ipaddr lan_ip lan || return 0
	[ -n "$lan_ip" ] || return 0

	# CGI 只做短请求（见 cgi-bin/api 头注释）：-t 30 秒上限、-n 6 个并发
	procd_open_instance web
	procd_set_param command /usr/sbin/uhttpd -f -p "$lan_ip:$port" -h "$WWW" -x /cgi-bin \
		-t 30 -T 30 -n 6 -N 48 -D -S -c /dev/null
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance

	# 没装 ucode-mod-socket（例如增量安装到旧路由器）就不启 STUN，页面照样可用
	[ -e /usr/lib/ucode/socket.so ] || return 0
	procd_open_instance speed
	procd_set_param command /usr/bin/ucode /usr/share/lan-transfer/speed.uc "$lan_ip" "$port"
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
	procd_open_instance stun
	procd_set_param command /usr/bin/ucode "$STUN" "$lan_ip" 3478
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	rm -f /tmp/lan-transfer/speed.json /tmp/lan-transfer/speed.json.tmp
}

service_triggers() {
	procd_add_reload_trigger lan-transfer network
	# LAN 地址变化时重新绑定；地址没变则 procd 比对参数后不会重启实例
	procd_add_interface_trigger 'interface.*' lan /etc/init.d/lan-transfer reload
}
