#!/bin/sh
# 邻传首刷：补权限、注册 procd 服务并当场启动。
# uci-defaults 在 S10 执行，此时 enable 生成的 S95 软链赶不上本次开机（v2.9.1 fw4guard 同款教训），
# 所以要当场 start 一次：LAN 还没起来时 start_service 直接返回，但接口触发器已注册，
# LAN 一就绪就会拉起服务。
[ -f /etc/config/lan-transfer ] || printf "config lan-transfer 'main'\n\toption enabled '1'\n\toption port '8080'\n" > /etc/config/lan-transfer
chmod 0755 /etc/init.d/lan-transfer /usr/share/lan-transfer/www/cgi-bin/api /usr/share/lan-transfer/www/cgi-bin/speed /usr/share/lan-transfer/stun.uc
/etc/init.d/lan-transfer enable
/etc/init.d/lan-transfer start 2>/dev/null
rm -f /tmp/luci-indexcache* /tmp/luci-modulecache/* 2>/dev/null
exit 0
