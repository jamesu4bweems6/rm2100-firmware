#!/bin/sh
# campus-fix v2.3: version stamp (queried via: cat /etc/campus-fix-version)
echo "2.12.0" > /etc/campus-fix-version

# Replace default banner with campus-fix usage notes
cat > /etc/banner <<EOF
 -----------------------------------------------------
 Redmi RM AC2100 - OpenWrt 24.10 (campus-fix build v$(cat /etc/campus-fix-version))

 Anti-detection: ACTIVE (nftables /etc/nftables.d/)
   TTL/hoplimit  -> 128           (nft list chain inet fw4 campus_ttl_postrouting)
   IP-ID         -> Windows式全局递增 (nft list chain inet fw4 campus_ipid_postrouting)
   DSCP/ECN      -> CS0           (nft list chain inet fw4 campus_dscp_postrouting)
   QUIC UDP/443  -> DROP          (nft list chain inet fw4 campus_quic_block)
   fw4 guard     -> ruleset dry-run at boot, quarantine on failure (logread -e campus-fw4guard)
   MSS           -> clamp to PMTU (greylisted return, guarded; nft list chain inet fw4 campus_mss_clamp)
   SYN rate      -> aggregate LAN cap 40/s burst 100 (nft list chain inet fw4 campus_synrate)
   DNS           -> forced to system resolver (dnsmasq, no client bypass)
   DoT 853       -> DROP            (campus_leak_block)
   NetBIOS/SMB/SSDP/mDNS/LLMNR egress -> DROP (campus_leak_block)
   ICMP ts(13/14)-> DROP            (campus_leak_block)
   NTP           -> LAN redirected to router ntpd (campus_ntp_redirect)
   WAN MAC       -> 默认出厂 MAC；LuCI 页面 网络 > 校园网 MAC：查看/设置/克隆/换新/复原
   Portal 认证   -> LuCI 页面 网络 > 校园网认证：自动登录/掉线重连（凭据存 uci；v2.10 起完整浏览器会话形态：ABMS cookie + 静态资产前奏 + XHR 头集）
   IPv6          -> LAN RA/DHCPv6 off by default (no hop-limit leak path)

 Adjust: vi /etc/nftables.d/10-campus-ttl-fix.nft  (TTL 64 <-> 128)
         service firewall restart

 WAN setup: LuCI -> Network -> Interfaces -> wan
   DHCP auth portal: keep dhcp
   PPPoE dorm line:  switch proto to pppoe

 Detection notes:
   TTL        fixed (campus_ttl_postrouting)
   IP-MAC     NAT presents single router MAC (inherent)
   client#    only the router authenticates (inherent)
   UA/finger  TCP TLS now enforced (QUIC blocked); per-client browser
              extension still recommended for full UA consistency
 -----------------------------------------------------
EOF

# Disable IPv6 RA/DHCPv6 announcements on LAN by default: with IPv6 enabled,
# downstream devices get global addresses and hop-limit leaks + unique-prefix
# fingerprints become possible. NAT66-less LAN is the safest posture here.
# (WAN IPv6 stays enabled harmlessly; if campus requires v6 auth, re-enable
# ra_management below.)
uci -q set dhcp.lan.ra='disabled' 2>/dev/null
uci -q set dhcp.lan.dhcpv6='disabled' 2>/dev/null
uci -q commit dhcp 2>/dev/null

# --- LuCI footer: append "campus-fix vX.Y.Z" next to the theme credits ---
# The web UI shows no campus-fix version anywhere; the only way to tell what
# is flashed is `cat /etc/campus-fix-version` over ssh. Patch the theme footer
# templates so every LuCI page (and the login page) displays it.
#
# Argon (the default theme since v2.4) and bootstrap both print a
# "Powered by LuCI ... | ArgonTheme vX | OpenWrt ..." line in their footer
# templates; we splice our stamp after the theme entry, reusing the theme's
# own separator markup so the line stays visually consistent.
# Idempotent (grep guard): re-running must not stack duplicate stamps.
# NOTE sed BRE: \(...\) is a GROUP, bare ) is a literal paren - hence
# "distrevision }})</a>" matching bootstrap's "(...)" without escapes.
# Delimiter is | (not #): the color code #5e72e4 inside STAMP would eat
# a # delimiter.
FWV=$(cat /etc/campus-fix-version)
# Version stamp gets its own color (#5e72e4, the Argon primary-blue family)
# so it stands out from the theme's stock link styling at a glance. Kept as
# a plain <span> (no link) - it is a build label, not a navigable target.
STAMP='<span style="color:#5e72e4;font-weight:600">campus-fix v'"${FWV}"'</span>'
for f in /usr/share/ucode/luci/template/themes/argon/footer.ut \
         /usr/share/ucode/luci/template/themes/argon/footer_login.ut; do
	if [ -f "$f" ] && ! grep -q "campus-fix v" "$f"; then
		sed -i "s|\(ArgonTheme v[0-9.]*\)</a>|\1</a> / ${STAMP}|" "$f"
	fi
done
f=/usr/share/ucode/luci/template/themes/bootstrap/footer.ut
if [ -f "$f" ] && ! grep -q "campus-fix v" "$f"; then
	sed -i "s|distrevision }})</a>|& / ${STAMP}|" "$f"
fi
# ucode templates are compiled once and cached in /tmp/luci-modulecache
rm -f /tmp/luci-indexcache* /tmp/luci-modulecache/* 2>/dev/null

exit 0
