#!/usr/bin/ucode
// 无 socket 模块时保留 CGI 兼容入口。
'use strict';
import { request, emit } from '../../api.uc';
emit(request({
	REQUEST_METHOD: getenv('REQUEST_METHOD'), QUERY_STRING: getenv('QUERY_STRING'),
	CONTENT_TYPE: getenv('CONTENT_TYPE'), CONTENT_LENGTH: getenv('CONTENT_LENGTH'),
	HTTP_HOST: getenv('HTTP_HOST'), HTTP_ORIGIN: getenv('HTTP_ORIGIN'),
	SERVER_ADDR: getenv('SERVER_ADDR'), SERVER_PORT: getenv('SERVER_PORT'),
	REMOTE_ADDR: getenv('REMOTE_ADDR')
}, null, null, 800));
