#!/bin/sh
# 远程开机：向 LAN 口二层广播魔术包。用法：wake <MAC>
# 巴法云守护进程和 LuCI「立即唤醒」按钮共用这一个入口，ACL 只放行它，不放行任意命令。
mac=$(printf '%s' "$1" | tr 'abcdef-' 'ABCDEF:')
H='[0-9A-F][0-9A-F]'
case "$mac" in
	$H:$H:$H:$H:$H:$H) ;;
	*) echo "MAC 地址无效：$1" >&2; exit 2 ;;
esac

dev=
if [ -r /lib/functions/network.sh ]; then
	. /lib/functions/network.sh
	network_get_device dev lan
fi
[ -n "$dev" ] || dev=br-lan

# 发 3 轮，每轮一个广播包（-b，目的 ff:ff:ff:ff:ff:ff：电脑关机后交换芯片早已忘了它的 MAC，广播才能保证送达）
# 和一个直接发给电脑 MAC 的包（个别网卡关机后只认目的地址是自己的魔术包）。
# 魔术包本身无副作用，多发几个是为了扛住偶发丢包。任意一个发送成功即算成功。
ok=1
for round in 1 2 3; do
	/usr/bin/etherwake -b -i "$dev" "$mac" && ok=0
	/usr/bin/etherwake -i "$dev" "$mac" && ok=0
done
exit $ok
